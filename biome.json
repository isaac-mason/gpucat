{
    "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": { "ignoreUnknown": false, "includes": ["**", "!**/src/nodes/nodes.ts"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 130 },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "noParameterAssign": "off",
                "noRestrictedGlobals": {
                    "level": "error",
                    "options": {
                        "deniedGlobals": {
                            "FinalizationRegistry": "Lifetimes follow owners: release in dispose(), never when the garbage collector runs.",
                            "WeakRef": "Lifetimes follow owners: hold or release explicitly, never by what the garbage collector keeps."
                        }
                    }
                }
            },
            "suspicious": {
                "noExplicitAny": "off"
            }
        }
    },
    "javascript": { "formatter": { "quoteStyle": "single" } }
}
