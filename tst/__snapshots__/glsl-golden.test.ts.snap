      "groupIndex": 0,
      "groupName": "render",
      "members": [
        {
          "id": "screenSize",
          "offset": 0,
          "size": 8,
        },
      ],
      "totalBytes": 8,
    },
  ],
  "varyings": [],
  "vertexEntryPoint": "main",
}
`;

