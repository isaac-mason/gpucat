exports[`golden GLSL — render path > lit mesh: attributes, camera/model uniforms, varying, vec math 1`] = `
{
  "builtins": [],
  "code": "#version 300 es
// Uniform blocks (std140)
layout(std140) uniform Uniforms_render {
    mat4 cameraProjectionMatrix;
    mat4 cameraViewMatrix;
} uniforms_render;

layout(std140) uniform Uniforms_object {
    mat4 modelWorldMatrix;
    mat3 modelNormalMatrix;
} uniforms_object;

// Vertex shader
layout(location = 0) in vec3 a_normal;
layout(location = 1) in vec3 a_position;

out vec3 vNormal;

void main() {
    vNormal = normalize((uniforms_object.modelNormalMatrix * a_normal));
    gl_Position = (uniforms_render.cameraProjectionMatrix * (uniforms_render.cameraViewMatrix * (uniforms_object.modelWorldMatrix * vec4(a_position, 1.0))));
}

// ---- fragment stage ----

#version 300 es
precision highp float;
precision highp int;
// Uniform blocks (std140)
layout(std140) uniform Uniforms_render {
    mat4 cameraProjectionMatrix;
    mat4 cameraViewMatrix;
} uniforms_render;

layout(std140) uniform Uniforms_object {
    mat4 modelWorldMatrix;
    mat3 modelNormalMatrix;
} uniforms_object;

// Fragment shader
in vec3 vNormal;

layout(location = 0) out vec4 fragColor;

void main() {
    fragColor = vec4((vec3(0.4, 0.7, 1.0) * (0.15 + max(dot(vNormal, normalize(vec3(0.6, 1.0, 0.8))), 0.0))), 1.0);
}",
