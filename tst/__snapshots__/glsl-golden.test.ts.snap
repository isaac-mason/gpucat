{
  "builtins": [
    "position",
  ],
  "code": "#version 300 es
// Uniform blocks (std140)
layout(std140) uniform Uniforms_render {
    vec2 screenSize;
} uniforms_render;

// Combined samplers
precision highp sampler2D;
uniform sampler2D u_t0;
uniform bool u_flipY_t0;
vec2 _flipY2f(bool f, vec2 uv) { return f ? vec2(uv.x, 1.0 - uv.y) : uv; }
ivec2 _flipY2i(bool f, ivec2 c, int h) { return f ? ivec2(c.x, h - c.y - 1) : c; }
// Vertex shader
layout(location = 0) in vec3 a_position;

void main() {
    gl_Position = vec4(a_position, 1.0);
}

// ---- fragment stage ----

#version 300 es
precision highp float;
precision highp int;
// Uniform blocks (std140)
layout(std140) uniform Uniforms_render {
    vec2 screenSize;
} uniforms_render;

// Combined samplers
precision highp sampler2D;
uniform sampler2D u_t0;
uniform bool u_flipY_t0;
vec2 _flipY2f(bool f, vec2 uv) { return f ? vec2(uv.x, 1.0 - uv.y) : uv; }
ivec2 _flipY2i(bool f, ivec2 c, int h) { return f ? ivec2(c.x, h - c.y - 1) : c; }
// Fragment shader
layout(location = 0) out vec4 fragColor;

uniform highp float u_fragCoordFlipHeight;

void main() {
    fragColor = texture(u_t0, _flipY2f(u_flipY_t0, ((vec4(gl_FragCoord.x, u_fragCoordFlipHeight - gl_FragCoord.y, gl_FragCoord.z, gl_FragCoord.w)).xy / uniforms_render.screenSize)));
}",
  "fragmentEntryPoint": "main",
  "samplers": [
    {
      "binding": 0,
      "group": 0,
      "samplerId": "t0_sampler",
      "type": "sampler",
    },
  ],
  "textures": [
    {
      "binding": 0,
      "group": 0,
      "textureId": "t0",
      "type": "sampler2D",
    },
  ],
  "uniformGroups": [
